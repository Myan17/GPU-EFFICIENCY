# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Job Configuration ────────────────────────────────────────────
JOB_ID=job-001
TOTAL_EPOCHS=50
EPOCH_DURATION_SECONDS=8

# ── Fault Injection ──────────────────────────────────────────────
# Scenario options: NORMAL | IDLE_GPU | STALL | OOM_CRASH
SCENARIO=NORMAL
FAULT_INJECT_AFTER_EPOCH=10

# ── Infrastructure ───────────────────────────────────────────────
# Instance type affects cost calculations
# Options: g4dn.xlarge | g4dn.2xlarge | p3.2xlarge | p2.xlarge
INSTANCE_TYPE=g4dn.xlarge

# ── Optimization Engine ──────────────────────────────────────────
POLL_INTERVAL_SECONDS=30
IDLE_GPU_THRESHOLD_PERCENT=10
IDLE_GPU_DURATION_SECONDS=900
STALL_THRESHOLD_SECONDS=600
ALERT_COOLDOWN_SECONDS=300

# ── Slack ────────────────────────────────────────────────────────
# See README.md for how to obtain this URL
SLACK_WEBHOOK_URL= slack_webhook 